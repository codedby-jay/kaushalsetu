# =============================================================================
# KaushalSetu — environment template
# Copy this file to server/.env for the API. Do not commit real secrets.
# JWT_SECRET is reserved for Phase 2 authentication and is unused in Phase 1.
# =============================================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (required for Prisma migrate and a "database": "up" health check)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kaushalsetu?schema=public

# Reserved for Phase 2 — do not use in Phase 1
JWT_SECRET=change-this-to-a-long-random-string

# Client (Vite). Place VITE_* values in client/.env if you are not using the
# development proxy. The default fallback in code is /api.
VITE_API_URL=/api
