generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  INDUSTRY
  ACADEMICIAN
  INSTITUTION
  ADMIN
}

enum SkillCategory {
  TECHNICAL
  SOFT
}

enum OpportunityType {
  INTERNSHIP
  APPRENTICESHIP
  JOB
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         UserRole        @default(STUDENT)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  profile      StudentProfile?
}

model StudentProfile {
  id                 String              @id @default(uuid())
  userId             String              @unique
  headline           String?
  bio                String?
  phone              String?
  location           String?
  education          String?
  college            String?
  degree             String?
  graduationYear     Int?
  githubUrl          String?
  linkedinUrl        String?
  portfolioUrl       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  skills             StudentSkill[]
  assessmentAttempts AssessmentAttempt[]
}

model Skill {
  id                    String                  @id @default(uuid())
  name                  String                  @unique
  category              SkillCategory
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  studentSkills         StudentSkill[]
  assessmentQuestions   AssessmentQuestion[]
  skillAssessmentResults SkillAssessmentResult[]
}

model StudentSkill {
  id               String         @id @default(uuid())
  studentProfileId String
  skillId          String
  proficiency      Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profile          StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill            Skill          @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([studentProfileId, skillId])
}

model Assessment {
  id          String                @id @default(uuid())
  title       String                @unique
  description String
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  questions   AssessmentQuestion[]
  attempts    AssessmentAttempt[]
}

model AssessmentQuestion {
  id            String                 @id @default(uuid())
  assessmentId  String
  skillId       String
  questionText  String
  options       Json
  correctIndex  Int
  difficulty    QuestionDifficulty     @default(MEDIUM)
  points        Int                    @default(1)
  sortOrder     Int
  createdAt     DateTime               @default(now())
  assessment    Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  skill         Skill                  @relation(fields: [skillId], references: [id], onDelete: Restrict)
  answers       AssessmentAnswer[]

  @@index([assessmentId, sortOrder])
}

model AssessmentAttempt {
  id               String                   @id @default(uuid())
  assessmentId     String
  studentProfileId String
  status           AssessmentAttemptStatus  @default(IN_PROGRESS)
  score            Int?
  totalPoints      Int?
  percentage       Int?
  startedAt        DateTime                 @default(now())
  submittedAt      DateTime?
  assessment       Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  profile          StudentProfile           @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  answers          AssessmentAnswer[]
  skillResults     SkillAssessmentResult[]

  @@index([studentProfileId, assessmentId, status])
}

model AssessmentAnswer {
  id             String              @id @default(uuid())
  attemptId      String
  questionId     String
  selectedIndex  Int
  isCorrect      Boolean
  pointsEarned   Int
  attempt        AssessmentAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
}

model SkillAssessmentResult {
  id                     String            @id @default(uuid())
  attemptId              String
  skillId                String
  correctCount           Int
  questionCount          Int
  pointsEarned           Int
  pointsAvailable        Int
  percentage             Int
  calculatedProficiency  Int
  attempt                AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  skill                  Skill             @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@unique([attemptId, skillId])
}
